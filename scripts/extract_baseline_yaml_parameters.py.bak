# ============================================================
# OUTPUT
# ============================================================

df = pd.DataFrame(rows)

df.to_csv(
    OUT_CSV,
    index=False,
    encoding="utf-8-sig",
)


with open(
    OUT_TXT,
    "w",
    encoding="utf-8",
) as f:

    f.write(
        "BASELINE 2026 - PARAMETROS EXTRAIDOS DOS YAMLs\n"
    )

    f.write("=" * 80 + "\n\n")

    for route in ["H2", "B1"]:

        f.write(f"\n=== {route} ===\n\n")

        subset = df[
            df["route"] == route
        ]

        f.write(
            subset[
                [
                    "id",
                    "group",
                    "parameter",
                    "unit",
                    "value_2026",
                    "yaml_path",
                    "status",
                ]
            ].to_string(
                index=False
            )
        )

        f.write("\n")


print()
print("=== YAML EXTRACTION COMPLETE ===")
print("H2 config =", H2_CONFIG)
print("B1 config =", B1_CONFIG)

print()
print("rows =", len(df))

print()
print("=== NOT FOUND ===")

missing = df[
    df["value_2026"].isna()
]

if missing.empty:
    print("NONE")
else:
    print(
        missing[
            [
                "route",
                "parameter",
                "yaml_path",
            ]
        ].to_string(
            index=False
        )
    )

